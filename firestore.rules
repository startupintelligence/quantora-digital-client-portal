rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function hasUser(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));}
  function user(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function admin(){return hasUser() && user().role in ['admin','founder'];}
  function member(org){return hasUser() && user().organizationId == org;}
  function canRead(org){return admin() || member(org);}
  match /users/{uid}{allow get: if signedIn() && (request.auth.uid == uid || admin());allow list: if admin();allow create,delete: if admin();allow update: if admin() || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','phone','updatedAt']) && request.resource.data.role == resource.data.role && request.resource.data.organizationId == resource.data.organizationId);}
  match /organizations/{org}{allow read: if canRead(org);allow write: if admin();match /members/{uid}{allow read: if admin() || (signedIn() && request.auth.uid == uid && member(org));allow write: if admin();}}
  match /projects/{id}{allow read: if canRead(resource.data.organizationId);allow create: if admin() && request.resource.data.organizationId is string;allow update,delete: if admin();}
  match /tasks/{id}{allow read: if canRead(resource.data.organizationId);allow create: if admin() && request.resource.data.organizationId is string;allow delete: if admin();allow update: if admin() || (signedIn() && member(resource.data.organizationId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['todo','in_progress','done'] && request.resource.data.organizationId == resource.data.organizationId);}
  match /messages/{id}{allow read: if canRead(resource.data.organizationId);allow create: if signedIn() && member(request.resource.data.organizationId) && request.resource.data.senderUid == request.auth.uid;allow update,delete: if admin();}
  match /approvals/{id}{allow read: if canRead(resource.data.organizationId);allow create,delete: if admin();allow update: if admin() || (signedIn() && member(resource.data.organizationId) && resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','clientNote','respondedAt']) && request.resource.data.status in ['approved','changes_requested']);}
  match /invoices/{id}{allow read: if canRead(resource.data.organizationId);allow write: if admin();}
  match /notifications/{id}{allow read: if signedIn() && resource.data.userId == request.auth.uid;allow write: if admin();}
  match /auditLogs/{id}{allow read: if admin();allow write: if false;}
  match /{document=**}{allow read,write: if false;}
 }
}